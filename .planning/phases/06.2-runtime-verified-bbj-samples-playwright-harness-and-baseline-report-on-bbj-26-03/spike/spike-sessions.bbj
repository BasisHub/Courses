rem Spike: list BBj interpreter sessions and license use, or terminate sessions whose
rem program path contains a marker. Arguments: <result file> <env file> list|kill [marker]
use com.basis.api.admin.BBjAdminFactory
use com.basis.api.admin.BBjAdminBBjProcess
use java.io.File
use java.io.FileWriter
use java.nio.file.Files

seterr onError
out! = argv(1)
envFile! = argv(2)
mode! = argv(3)
marker! = ""
if argc > 4 then marker! = argv(4)
marker! = marker!.toLowerCase()

user! = ""
pass! = ""
lines! = Files.readAllLines(new File(envFile!).toPath())
it! = lines!.iterator()
while it!.hasNext()
    line! = it!.next()
    if line!.startsWith("BBJ_ADMIN_USER=") then user! = line!.substring(15)
    if line!.startsWith("BBJ_ADMIN_PASSWORD=") then pass! = line!.substring(19)
wend

admin! = BBjAdminFactory.getBBjAdmin(user!, pass!)
w! = new FileWriter(out!)
lic! = admin!.getLicenseFeatureInfo("BBJ")
w!.write("LICENSE BBJ total=" + str(lic!.getTotalUserCount()) + " inUse=" + str(lic!.getNumberInUse()) + $0a$)

procs! = admin!.getBBjProcesses()
it! = procs!.iterator()
while it!.hasNext()
    proc! = it!.next()
    prog! = proc!.getString(BBjAdminBBjProcess.PROGRAM_NAME)
    if prog! = null() then prog! = ""
    line! = "PROC id=" + proc!.getString(BBjAdminBBjProcess.PROCESS_ID) + " fid0=" + str(proc!.getString(BBjAdminBBjProcess.FID_0)) + " since=" + str(proc!.getString(BBjAdminBBjProcess.CONNECTION_TIME)) + " prog=" + prog!
    if mode! = "kill" and marker! > "" and prog!.toLowerCase().contains(marker!) and !prog!.toLowerCase().endsWith("spike-sessions.bbj") then
        proc!.terminate()
        line! = line! + " -> TERMINATED"
    endif
    w!.write(line! + $0a$)
wend
w!.close()
admin!.release()
release

onError:
    w! = new FileWriter(out!, 1)
    w!.write("ERROR " + str(err) + " at line " + str(tcb(5)) + ": " + errmes(-1) + $0a$)
    w!.close()
    release
