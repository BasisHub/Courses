{
  "name": "courses-sample-test",
  "private": true,
  "description": "Runs every BBj program under docs/examples in DWC on a local BBj and records the results",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test lib/*.test.js tests/*.test.js",
    "selftest": "playwright test --project=selftest",
    "samples": "playwright test --project=samples",
    "compile": "node compile.mjs",
    "report": "node report.mjs",
    "cleanup": "node cleanup.mjs",
    "baseline": "node run-baseline.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
