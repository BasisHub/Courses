declare auto BBjSysGui sysgui!
declare auto BBjTopLevelWindow wnd!

sysgui! =  BBjAPI().openSysGui("X0")
programPath$ = BBjAPI().getProgramInfo(pgm(-2)).getCanonicalProgramName()
resourcePath$ = java.nio.file.Paths.get(programPath$).resolveSibling("ArcSample.arc").toString()
res = sysgui!.resOpen(resourcePath$)
wnd! = sysgui!.createTopLevelWindow(res,101)

wnd!.setCallback(BBjAPI.ON_CLOSE,"byebye")
wnd!.getControl("BTN_OK").setCallback(BBjAPI.ON_BUTTON_PUSH,"sayhello")

process_events

byebye: bye

sayhello:
    firstname$=wnd!.getControl("ED_FIRSTNAME").getText()
    name$=wnd!.getControl("ED_LASTNAME").getText()
    a=msgbox("Hello "+firstname$+" "+name$,64,"Hello World")
return
