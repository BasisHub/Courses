rem Embed a Shoelace split panel with BBjWebComponent and named slots.
rem Run in the DWC with BBj 24.11 or later. The browser needs internet access.
rem https://documentation.basis.cloud/BASISHelp/WebHelp/bbjobjects/Window/BBjWebComponent/BBjWebComponent_setSlot.htm

declare auto BBjWebManager web!
declare auto BBjTopLevelWindow window!
declare auto BBjWebComponent splitter!
declare auto BBjWebComponent handleIcon!
declare auto BBjChildWindow top!
declare auto BBjChildWindow bottom!

if info(3,6) <> "6" then
    choice = msgbox("Run this sample in the DWC browser client.",48,"Shoelace Splitter")
    release
endif

web! = BBjAPI().getWebManager()
web!.injectStyleUrl("https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css")
web!.injectScriptUrl("https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/shoelace.js",1,"type=module")

window! = BBjAPI().openSysGui("X0").addWindow("Shoelace Splitter",$01101083$)
window!.setCallback(BBjAPI.ON_CLOSE,"eoj")
window!.setPanelStyle("display","grid")
window!.setPanelStyle("height","100vh")
window!.setPanelStyle("grid-template-rows","minmax(0,1fr)")

splitter! = window!.addWebComponent("sl-split-panel")
splitter!.setAttribute("vertical","true")
splitter!.setAttribute("position","50")
splitter!.setStyle("height","100%")

handleIcon! = window!.addWebComponent("dwc-icon")
handleIcon!.setAttribute("name","grip-horizontal")
splitter!.setSlot("handle",handleIcon!)

top! = window!.addChildWindow("",$00108800$,BBjAPI().getSysGui().getAvailableContext())
top!.setPanelStyle("display","grid")
top!.setPanelStyle("height","100%")
top!.addButton("This is the top panel").setAttribute("theme","danger")
splitter!.setSlot("start",top!)

bottom! = window!.addChildWindow("",$00108800$,BBjAPI().getSysGui().getAvailableContext())
bottom!.setPanelStyle("display","grid")
bottom!.setPanelStyle("height","100%")
bottom!.addButton("This is the bottom panel").setAttribute("theme","success")
splitter!.setSlot("end",bottom!)

process_events

eoj:
release
