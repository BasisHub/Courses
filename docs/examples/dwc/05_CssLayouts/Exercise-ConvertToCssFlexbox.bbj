rem /**
rem  * Exercise-ConvertToCssFlexbox.bbj
rem  *
rem  * This exercise displays a short form in a window with flow layout.
rem  *
rem  * Exercise Goals:
rem  *  1) Add a window!.setPanelStyle() call that sets the window's CSS display
rem  *     property to "flex" to switch to a flexbox layout.
rem  *
rem  *  2) Add a window!.setPanelStyle() call that sets the window's CSS
rem  *     flex-direction property to "column" so that the controls are laid out
rem  *     vertically.
rem  *
rem  *  3) Add window!.setPanelStyle() calls for padding around the window and a
rem  *     gap between the controls.
rem  *
rem  *  4) Note that we used the succinct versions of the BBjWindow::addEditBox()
rem  *     methods that just take the control's contents, and we chained the
rem  *     BBjControl::setAttribute() method resulting in an edit box with a
rem  *     label in one line of code. setAttribute() returns nothing, so the
rem  *     result of the chain is not stored in a variable. If you need the edit
rem  *     box later, store it first and call setAttribute() on the variable.
rem  */


rem If the app is running in BUI, switch it automatically to run in the DWC client instead
rem ================================================================================
if (info(3, 6) = "5") then
    bui! = BBjAPI().getBuiManager()
    url! = bui!.getUrl().replaceAll("apps", "webapp")
    action! = bui!.urlAction(url!)
    bui!.setEndAction(action!)
    release
endif


sysgui = unt
open (sysgui)"X0"
sysgui! = bbjapi().getSysGui()
window! = sysgui!.addWindow("CSS Flexbox and Label Attributes",$00190083$)
window!.setCallback(window!.ON_CLOSE, "onClose")
window!.setPanelStyle("width", "100%")
window!.setPanelStyle("height", "100%")
window!.setPanelStyle("box-sizing", "border-box")


rem Add the controls to the window
window!.addEditBox("Joe Blow").setAttribute("label", "Name:")
window!.addEditBox("BASIS International Ltd.").setAttribute("label", "Company:")
window!.addEditBox("joeBlow@basis.com").setAttribute("label", "Email:")


process_events

onClose:
release

declare auto BBjSysGui sysgui!
declare auto BBjTopLevelWindow window!
