declare BBjTopLevelWindow wnd!
declare BBjStaticText st!
declare BBjEditBox ed_firstname!
declare BBjEditBox ed_lastname!
declare BBjButton btn!

rem Register sample.css with the app in Enterprise Manager as shown in the lesson.

wnd! = BBjAPI().openSysGui("X0").addWindow(10,10,800,600,"Hello BBj DWC",$01101083$)

REM setting the styles into the style property of the element 
REM wnd!.setPanelStyle("display","inline-grid")
REM wnd!.setPanelStyle("grid-template-columns","1fr 1fr")
REM wnd!.setPanelStyle("gap","5px")

REM with the sample css you would write the following to set a CSS class selector:
wnd!.addPanelStyle("mypanel")

st! = wnd!.addStaticText(wnd!.getAvailableControlID(),10,10,200,20,"First name:")
ed_firstname! = wnd!.addEditBox(wnd!.getAvailableControlID(),210,10,200,20,"")
st! = wnd!.addStaticText(wnd!.getAvailableControlID(),10,40,200,20,"Last name:")
ed_lastname! = wnd!.addEditBox(wnd!.getAvailableControlID(),210,40,200,20,"")
btn! = wnd!.addButton(wnd!.getAvailableControlID(),10,70,400,30,"Say Hello")


btn!.setStyle("grid-column","2")

btn!.setAttribute("expanse","xl")
btn!.setAttribute("theme","success")

rem to set a css class use "addStyle"
rem btn!.addStyle("myButtonClass")


wnd!.setCallback(BBjAPI.ON_CLOSE,"byebye")
btn!.setCallback(BBjAPI.ON_BUTTON_PUSH,"sayhello")
process_events

byebye: bye

sayhello:
    firstname$=ed_firstname!.getText()
    lastname$=ed_lastname!.getText()
    a=msgbox("Hello "+firstname$+" "+lastname$,64,"Hello World")
return
